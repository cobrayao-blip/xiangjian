# 阿里云百炼 / DashScope API Key（通义千问）
# 获取：https://help.aliyun.com/zh/model-studio/get-api-key
DASHSCOPE_API_KEY="sk-xxxxxxxx"

# 模型名称，可选：qwen-turbo、qwen-plus、qwen-max 等
# 文档：https://help.aliyun.com/zh/model-studio/getting-started/models
QWEN_MODEL="qwen-plus"

# OpenAI 兼容接口地址（国内默认北京，一般无需修改）
# DASHSCOPE_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# 服务端口（可选）
# PORT=3000

# 子路径部署（与 Nginx location /xiangjian 一致）— 须成对配置：
# 运行时：BASE_PATH=/xiangjian
# 构建前：VITE_BASE_PATH=/xiangjian/
# Docker 镜像已在 Dockerfile 中预设 VITE_BASE_PATH=/xiangjian/
